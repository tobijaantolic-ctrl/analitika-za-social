FLASK_ENV=production
SECRET_KEY=change-me-to-a-long-random-value
DATABASE_URL=sqlite:////data/analytics.db
UPLOAD_DIR=/data/uploads
PORT=5455
HOST=0.0.0.0
PUBLIC_BASE_URL=https://your-domain.com

AUTH_REQUIRED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=pbkdf2:sha256:1000000$replace-with-werkzeug-hash

YOUTUBE_API_KEY=
ENABLE_OPENCLAW=false
OPENCLAW_URL=ws://localhost:18789
OPENCLAW_TOKEN=

TRANSCRIPTION_ENABLED=false
TRANSCRIPTION_PYTHON=python
WHISPER_MODEL=turbo
WHISPER_LANGUAGE=sl

PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
MAX_UPLOAD_MB=600
